        "# ================= TASK 3: IDDFS on the 8-puzzle (Lab 2) =================\n",
        "print(\"=\" * 60)\n",
        "print(\"TASK 3: IDDFS on the 8-puzzle (Lab 2)\")\n",
        "print(\"=\" * 60)\n",
        "\n",
        "GOAL = (1, 2, 3,\n",
        "        4, 5, 6,\n",
        "        7, 8, 0)                       # 0 represents the blank tile\n",
        "MOVES = {'Up': -3, 'Down': 3, 'Left': -1, 'Right': 1}\n",
        "\n",
        "def actions(state):\n",
        "    \"\"\"Return the legal moves of the blank tile (Lab 2).\"\"\"\n",
        "    i = state.index(0)\n",
        "    row, col = divmod(i, 3)\n",
        "    legal = []\n",
        "    if row > 0: legal.append('Up')\n",
        "    if row < 2: legal.append('Down')\n",
        "    if col > 0: legal.append('Left')\n",
        "    if col < 2: legal.append('Right')\n",
        "    return legal\n",
        "\n",
        "def result(state, action):\n",
        "    \"\"\"Transition model: swap the blank with the neighbouring tile (Lab 2).\"\"\"\n",
        "    i = state.index(0)\n",
        "    j = i + MOVES[action]\n",
        "    s = list(state)\n",
        "    s[i], s[j] = s[j], s[i]\n",
        "    return tuple(s)\n",
        "\n",
        "expanded = 0\n",
        "\n",
        "def dls_puzzle(state, limit, path):\n",
        "    \"\"\"Depth-limited search on the 8-puzzle. 'path' holds states on the current path (avoids loops).\"\"\"\n",
        "    global expanded\n",
        "    if state == GOAL:\n",
        "        return 'found'\n",
        "    if limit == 0:\n",
        "        return 'cutoff'\n",
        "    expanded += 1                       # this node is expanded (its children are generated)\n",
        "    cutoff_occurred = False\n",
        "    for a in actions(state):\n",
        "        child = result(state, a)\n",
        "        if child in path:\n",
        "            continue\n",
        "        path.add(child)\n",
        "        res = dls_puzzle(child, limit - 1, path)\n",
        "        path.remove(child)\n",
        "        if res == 'found':\n",
        "            return 'found'\n",
        "        if res == 'cutoff':\n",
        "            cutoff_occurred = True\n",
        "    return 'cutoff' if cutoff_occurred else 'failure'\n",
        "\n",
        "start = (1, 2, 3,\n",
        "         4, 0, 6,\n",
        "         7, 5, 8)\n",
        "\n",
        "total_expanded = 0\n",
        "for depth in range(0, 31):\n",
        "    expanded = 0\n",
        "    res = dls_puzzle(start, depth, {start})\n",
        "    total_expanded += expanded\n",
        "    print(f\"Depth limit {depth}: {res:6s} (nodes expanded in this iteration: {expanded})\")\n",
        "    if res == 'found':\n",
        "        print(\"\\nGoal found at depth:\", depth)\n",
        "        print(\"Nodes expanded (total across all iterations):\", total_expanded)\n",
        "        break"
