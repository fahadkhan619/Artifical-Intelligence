      "source": [
        "# ================= TASK 1: Total nodes visited by IDDFS vs BFS =================\n",
        "print(\"=\" * 60)\n",
        "print(\"TASK 1: Total nodes visited by IDDFS vs BFS\")\n",
        "print(\"=\" * 60)\n",
        "\n",
        "import networkx as nx\n",
        "import matplotlib.pyplot as plt\n",
        "from collections import deque\n",
        "\n",
        "# ---------- Search tree from Lab 4 (goal = J) ----------\n",
        "tree = {\n",
        "    'A': ['B', 'C'],\n",
        "    'B': ['D', 'E'],\n",
        "    'C': ['F', 'G'],\n",
        "    'D': ['H', 'I'],\n",
        "    'E': ['J'],\n",
        "    'F': ['K'],\n",
        "    'G': [],\n",
        "    'H': [], 'I': [], 'J': [], 'K': []\n",
        "}\n",
        "\n",
        "def dls(node, goal, limit, visited_order):\n",
        "    \"\"\"Recursive Depth-Limited Search. Returns 'found', 'cutoff' or 'failure'.\"\"\"\n",
        "    visited_order.append(node)\n",
        "    if node == goal:\n",
        "        return 'found'\n",
        "    if limit == 0:\n",
        "        return 'cutoff'\n",
        "    cutoff_occurred = False\n",
        "    for child in tree[node]:\n",
        "        res = dls(child, goal, limit - 1, visited_order)\n",
        "        if res == 'found':\n",
        "            return 'found'\n",
        "        if res == 'cutoff':\n",
        "            cutoff_occurred = True\n",
        "    return 'cutoff' if cutoff_occurred else 'failure'\n",
        "\n",
        "def iddfs(start, goal, max_depth=10):\n",
        "    \"\"\"Iterative deepening. Also counts the TOTAL nodes visited in all iterations.\"\"\"\n",
        "    total_visited = 0\n",
        "    per_depth = {}                      # depth limit -> nodes visited in that iteration\n",
        "    for depth in range(max_depth + 1):\n",
        "        order = []\n",
        "        res = dls(start, goal, depth, order)\n",
        "        total_visited += len(order)\n",
        "        per_depth[depth] = order\n",
        "        print(f\"Depth limit {depth}: visited {' '.join(order):<24} -> {res}  ({len(order)} nodes)\")\n",
        "        if res == 'found':\n",
        "            return depth, total_visited, per_depth\n",
        "    return None, total_visited, per_depth\n",
        "\n",
        "def bfs(start, goal):\n",
        "    \"\"\"Breadth-first search; returns the order in which nodes are visited.\"\"\"\n",
        "    frontier, seen, order = deque([start]), {start}, []\n",
        "    while frontier:\n",
        "        node = frontier.popleft()\n",
        "        order.append(node)\n",
        "        if node == goal:\n",
        "            break\n",
        "        for child in tree[node]:\n",
        "            if child not in seen:\n",
        "                seen.add(child)\n",
        "                frontier.append(child)\n",
        "    return order\n",
        "\n",
        "print(\"IDDFS, goal = 'J'\")\n",
        "depth, iddfs_total, per_depth = iddfs('A', 'J')\n",
        "bfs_order = bfs('A', 'J')\n",
        "\n",
        "print(\"\\n--- Comparison ---\")\n",
        "print(\"Goal found at depth      :\", depth)\n",
        "print(\"IDDFS total nodes visited:\", iddfs_total)\n",
        "print(\"BFS nodes visited        :\", len(bfs_order), \"->\", ' '.join(bfs_order))\n",
        "print(f\"IDDFS visits {iddfs_total - len(bfs_order)} more nodes than BFS because it repeats the upper levels in every iteration.\")"
      ]
