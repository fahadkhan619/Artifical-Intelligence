        "# ================= TASK 4: DLS on the Lab 3 maze with limits 5, 10, 15 =================\n",
        "print(\"=\" * 60)\n",
        "print(\"TASK 4: DLS on the Lab 3 maze with limits 5, 10, 15\")\n",
        "print(\"=\" * 60)\n",
        "\n",
        "# ---------- Maze from Lab 3: S = start, G = goal, # = wall ----------\n",
        "MAZE = [\"S . . . . # #\",\n",
        "        \"# # . # # . .\",\n",
        "        \". . . # . . #\",\n",
        "        \". # . . . . #\",\n",
        "        \". . . . # . G\"]\n",
        "grid = [row.split() for row in MAZE]\n",
        "ROWS, COLS = len(grid), len(grid[0])\n",
        "\n",
        "def find(ch):\n",
        "    for r in range(ROWS):\n",
        "        for c in range(COLS):\n",
        "            if grid[r][c] == ch:\n",
        "                return (r, c)\n",
        "\n",
        "def neighbours(cell):\n",
        "    r, c = cell\n",
        "    for dr, dc in [(-1, 0), (0, 1), (1, 0), (0, -1)]:      # Up, Right, Down, Left\n",
        "        nr, nc = r + dr, c + dc\n",
        "        if 0 <= nr < ROWS and 0 <= nc < COLS and grid[nr][nc] != '#':\n",
        "            yield (nr, nc)\n",
        "\n",
        "def dls_maze(cell, goal, limit, path):\n",
        "    \"\"\"Depth-limited search on the maze. Returns 'found', 'cutoff' or 'failure'.\"\"\"\n",
        "    if cell == goal:\n",
        "        return 'found'\n",
        "    if limit == 0:\n",
        "        return 'cutoff'\n",
        "    cutoff_occurred = False\n",
        "    for nb in neighbours(cell):\n",
        "        if nb in path:                  # do not walk in circles on the current path\n",
        "            continue\n",
        "        path.add(nb)\n",
        "        res = dls_maze(nb, goal, limit - 1, path)\n",
        "        path.remove(nb)\n",
        "        if res == 'found':\n",
        "            return 'found'\n",
        "        if res == 'cutoff':\n",
        "            cutoff_occurred = True\n",
        "    return 'cutoff' if cutoff_occurred else 'failure'\n",
        "\n",
        "S, GOAL_CELL = find('S'), find('G')\n",
        "print(\"Start:\", S, \" Goal:\", GOAL_CELL)\n",
        "for limit in [5, 10, 15]:\n",
        "    res = dls_maze(S, GOAL_CELL, limit, {S})\n",
        "    print(f\"Limit {limit:2d}: {res}\")"
