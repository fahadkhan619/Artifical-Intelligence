        "# ================= TASK 2: Visualise the search pattern (visited = green, unvisited = grey) =================\n",
        "print(\"=\" * 60)\n",
        "print(\"TASK 2: Visualise the search pattern (visited = green, unvisited = grey)\")\n",
        "print(\"=\" * 60)\n",
        "\n",
        "G = nx.DiGraph([(p, c) for p, cs in tree.items() for c in cs])\n",
        "\n",
        "# simple layered layout: each leaf gets its own x-slot, parents sit above children\n",
        "pos, next_x = {}, [0]\n",
        "def layout(n, d=0):\n",
        "    kids = tree[n]\n",
        "    if not kids:\n",
        "        pos[n] = (next_x[0], -d); next_x[0] += 1\n",
        "    else:\n",
        "        for k in kids: layout(k, d + 1)\n",
        "        pos[n] = (sum(pos[k][0] for k in kids) / len(kids), -d)\n",
        "layout('A')\n",
        "\n",
        "saved = []\n",
        "for d, visited in per_depth.items():\n",
        "    colors = ['green' if n in visited else 'grey' for n in G.nodes]   # colour list for nx.draw\n",
        "    plt.figure(figsize=(6, 3.6))\n",
        "    nx.draw(G, pos, with_labels=True, node_color=colors, node_size=700,\n",
        "            font_color='white', font_weight='bold', arrows=False)\n",
        "    plt.title(f\"IDDFS - depth limit {d} (green = visited, grey = unvisited)\")\n",
        "    fname = f\"iddfs_depth_{d}.png\"\n",
        "    plt.savefig(fname, dpi=130, bbox_inches='tight')\n",
        "    saved.append(fname)\n",
        "    plt.show()\n",
        "\n",
        "print(\"Images saved:\", saved)"
