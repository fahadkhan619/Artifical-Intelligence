        "# 1. Output and variables\n",
        "name, age, gpa, passed = \"fahad\", 21, 3.5, True\n",
        "print(f\"Name: {name}, Age: {age}, GPA: {gpa}, Passed: {passed}\")\n",
        "print(type(name), type(age), type(gpa), type(passed))\n",
        "\n",
        "# 2. Operators\n",
        "a, b = 17, 5\n",
        "print(a + b, a - b, a * b, a / b, a // b, a % b, a ** b)\n",
        "print(a > b, a == b, a > 10 and b < 10)\n",
        "\n",
        "# 3. Strings\n",
        "s = \"Hello Python\"\n",
        "print(s.upper(), s.lower(), s[0:5], s[::-1], len(s))\n",
        "print(s.replace(\"Python\", \"Colab\"), s.split())\n",
        "\n",
        "# 4. List\n",
        "nums = [5, 2, 9, 1]\n",
        "nums.append(7)\n",
        "nums.sort()\n",
        "print(nums, max(nums), min(nums), sum(nums))\n",
        "\n",
        "# 5. Tuple and Set\n",
        "t = (1, 2, 3)\n",
        "st = {1, 2, 2, 3, 3}\n",
        "print(t[0], st)\n",
        "\n",
        "# 6. Dictionary\n",
        "student = {\"name\": \"fahad\", \"age\": 21}\n",
        "student[\"city\"] = \"Islamabad\"\n",
        "for k, v in student.items():\n",
        "    print(k, \":\", v)\n",
        "\n",
        "# 7. If / else\n",
        "marks = 78\n",
        "if marks >= 80:\n",
        "    print(\"Grade A\")\n",
        "elif marks >= 70:\n",
        "    print(\"Grade B\")\n",
        "else:\n",
        "    print(\"Grade C\")\n",
        "\n",
        "# 8. Loops\n",
        "for i in range(1, 6):\n",
        "    print(i, end=\" \")\n",
        "print()\n",
        "n = 3\n",
        "while n > 0:\n",
        "    print(\"Countdown:\", n)\n",
